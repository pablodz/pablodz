{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pablodz-llm-workshop",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-10",
  "workers_dev": true,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/llm/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pablodz-llm-workshop",
      "database_id": "5c338967-e4d0-47d5-a181-e8596837460e",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
